{
  "$schema": "https://opencode.ai/config.json",
  // Совместимо с OpenCode V1/V2
  "permission": {
    "question": "allow",
    "skill": "allow",
    "task": "allow",
    "execute": "allow",
    "chrome_devtools_*": "allow",
    "playwright_*": "allow",

    "edit": "allow",
    "external_directory": "deny",

    "bash": {
      "*": "allow",

      // Git чтение
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git remote *": "allow",
      "git show *": "allow",

      // Git коммиты
      "git add *": "allow",
      "git commit *": "allow",

      // npm скрипты проекта
      "npm run dev *": "allow",
      "npm test *": "allow",
      "npm run test *": "allow",
      "npm run lint *": "allow",
      "npm run format *": "allow",
      "npm run format:check *": "allow",
      "npm run spec *": "allow",
      "npm run spec:generate *": "allow",
      "npm run spec:check *": "allow",
      "npm run spec:client *": "allow",
      "npm run spec:client:check *": "allow",
      "npm run spec:server *": "allow",
      "npm run spec:server:check *": "allow",
      "npm run build *": "allow",
      "npm run start *": "allow",

      // Установка зависимостей
      "npm install *": "allow",
      "npm i *": "allow",

      // Утилиты
      "npx prettier *": "allow",
      "npx vitest *": "allow",
      "npx shadcn *": "allow",

      // GitHub CLI
      "gh issue *": "allow",
      "gh pr *": "allow",
      "gh api *": "allow",

      // Опасные команды
      "git push": "deny",
      "git push *": "deny",
      "git commit --amend": "deny",
      "git commit --amend *": "deny",
      "git commit --fixup *": "deny",
      "git commit --squash *": "deny",
      "git rebase": "deny",
      "git rebase *": "deny",
      "git reset": "deny",
      "git reset *": "deny",
      "git branch -f *": "deny",
      "git update-ref *": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git clean *": "deny",
      "git branch -D *": "deny",
      "rm -rf *": "deny",
      "gh pr merge *": "deny",
      "gh pr close *": "deny"
    }
  },

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp",
      "oauth": false,
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:RENDER_API_TOKEN}"
      }
    }
  }
}
